rules_version = '2';

// 部署方式：Firebase Console → Firestore Database → 規則，貼上本檔內容後按「發布」
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理員的 Firebase Auth UID（與 .env 的 VITE_ADMIN_UID 相同）：GitHub、Google 登入各一個
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'r201Nrf54Qa3j4jPRE8D9GgbCMu1',
        'WNY9fbliEGMtwV2Ly2oaJRVhR583'
      ];
    }

    match /messages/{messageId} {
      allow read: if true;

      // 只能以自己的身分留言，欄位與長度受限，時間必須是伺服器時間
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'userAvatar', 'content', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 100
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.createdAt == request.time
        // 防洗版：必須與 rateLimits/{uid} 同一批寫入（該文件的規則限制兩次留言間隔）
        && getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastPostAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // 每位使用者最後一次留言的時間；兩次留言至少間隔 30 秒（與前端 MESSAGE_COOLDOWN_SECONDS 相同）
    match /rateLimits/{uid} {
      function isValidWrite() {
        return request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastPostAt'])
          && request.resource.data.lastPostAt == request.time;
      }

      allow create: if isValidWrite();
      allow update: if isValidWrite()
        && request.time > resource.data.lastPostAt + duration.value(30, 's');
      allow read, delete: if false;
    }

    // 其他集合一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
